# BOOOST — production environment template.
# Copy to .env and replace every value marked TODO.
# Never commit the real .env: it is gitignored.
#
# Public exposure via Tailscale Funnel:
#   tailscale funnel --bg 8080   ->   https://<machine>.<tailnet>.ts.net
# Cloudflare Tunnel works too; put its public hostname in the same fields.

# --- SUPABASE ---
# Dashboard -> Project Settings -> API.
# The service-role key bypasses RLS, so it must never reach the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI ---
# One key for every AI feature: the AI Coach chat, Home tips, warm-ups, meal ideas,
# workout adjustments and photo meal scanning.
# Any OpenAI-compatible API works; set your provider's base URL and model names:
#   Groq        https://api.groq.com/openai/v1
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama      http://host.docker.internal:11434/v1
# Leave AI_API_KEY empty to keep only the rule-based features; the AI Coach chat then
# answers "not available" (503).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
# Short tasks: warm-ups, meal ideas, workout adjustments and trainer insights.
AI_MODEL=openai/gpt-oss-20b
# The AI Coach chat and the model-written Home tips.
AI_TIPS_MODEL=openai/gpt-oss-120b
# Lets Premium users get Home tips reworded by AI_TIPS_MODEL (at most 8 a day).
# Rule-written tips show either way. It does not turn the AI Coach chat on or off.
AI_TIPS_MODEL_ENABLED=false

# Photo meal scanning needs an image-capable model; empty turns Scan plate off
# with a clear 503. It uses AI_API_KEY and AI_BASE_URL; fill the two below only
# when the vision model lives at a different provider.
# Example with OpenAI as the main provider: AI_VISION_MODEL=gpt-4o-mini
AI_VISION_MODEL=
AI_VISION_BASE_URL=
AI_VISION_API_KEY=

# --- AUTH ---
# TODO: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Signs the bearer sessions and the Community photo links. Rotating it logs every user out.
# Required: docker-compose refuses to start while it is empty.
AUTH_SECRET_KEY=
# Session lifetime in hours. 12 = daily re-login, 168 = weekly (the app default is 720).
AUTH_TOKEN_TTL_HOURS=12

# --- PASSWORD RESET EMAIL ---
# Optional. Without RESEND_API_KEY the reset form still answers, but no email is sent.
# Key from https://resend.com/api-keys. EMAIL_FROM must use a domain you own and have
# verified in Resend (Domains -> Add Domain); free shared domains and ts.net are refused.
RESEND_API_KEY=
EMAIL_FROM=BOOOST <no-reply@your-domain.com>
# Address people open the app at; the reset link is built from it.
APP_URL=https://your-machine.your-tailnet.ts.net

# --- DEPLOYMENT ---
# "production" disables /docs and /openapi.json.
ENVIRONMENT=production
# TODO: hostname only — no scheme, no port, no trailing slash.
# Tailscale Funnel example: zimaos.tailxxxx.ts.net
# (the exact value printed by `tailscale funnel status`).
# Always keep 127.0.0.1 and localhost: the container HEALTHCHECK calls
# http://127.0.0.1:8000/health, and without them the backend reports
# unhealthy and the frontend never starts (depends_on: service_healthy).
ALLOWED_HOSTS=127.0.0.1,localhost,your-machine.your-tailnet.ts.net
# Origin the browser actually uses: scheme + host, no trailing slash.
# "*" is rejected on purpose and the backend will not boot.
CORS_ORIGINS=https://your-machine.your-tailnet.ts.net
# Loopback port the tunnel forwards to: `tailscale funnel --bg 8080`.
# Compose publishes 127.0.0.1:${APP_PORT} only, never 0.0.0.0. If you change
# it, use the same number in the funnel command or the tunnel returns 502.
APP_PORT=8080
# Keep 1: the photo cache and the daily photo limit live in each worker's memory.
WEB_CONCURRENCY=1

# --- FRONTEND ---
# Fixed to "" by docker-compose.yml so the SPA calls nginx on its own origin.
# Do not set this: a different host breaks the CSP (connect-src 'self').
VITE_API_URL=
